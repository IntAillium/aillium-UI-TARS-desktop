VLM_PROVIDER=huggingface
VLM_BASE_URL=http://your_endpoint.aws.endpoints.huggingface.cloud/v1
VLM_API_KEY=hf_your_api_key
VLM_MODEL_NAME=your_model_name

# Base64-encoded Ed25519 SPKI public key used to verify short-lived desktop
# authority minted by Aillium Core. Never install Core's private key here.
AILLIUM_DESKTOP_AUTHORITY_PUBLIC_KEY_BASE64=
# Static bridge tokens and legacy mode are intentionally unsupported. Every
# desktop-control request must carry a valid, run-scoped Core authority token.

# Optional signed-envelope gateway for governed remote-computer effects. Direct
# MeshCentral proxy endpoints are rejected because they cannot acknowledge the
# exact run/step/fence/cancellation/idempotency identity. The gateway must
# implement POST /_aillium/fence/verify and echo all X-Aillium fence headers.
AILLIUM_MESH_FENCED_GATEWAY_URL=
